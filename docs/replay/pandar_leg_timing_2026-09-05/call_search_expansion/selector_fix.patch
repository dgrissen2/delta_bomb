 class ContractSelectionTests(unittest.TestCase):
+    def test_sell_first_checks_other_strikes_after_closest_delta_fails(self) -> None:
+        chain = pd.DataFrame([
+            self._row(100, .50, 5., 5.1, .40),
+            self._row(105, .10, .8, .9, .45),
+            self._row(110, .04, .10, .15, .50),
+            self._row(115, .03, .25, .30, .55),
+        ])
+        selected = SCREEN.select_sell_contract(chain, set())
+        self.assertTrue(selected['chain_confirmed'])
+        self.assertEqual(selected['leg1_strike'], 115)
+
+    def test_sell_first_uses_later_expiry_when_front_quotes_fail(self) -> None:
+        front = [self._row(100, .5, 5., 5.1, .4), self._row(110, .04, .1, .2, .5)]
+        later = [self._row(100, .5, 6., 6.1, .4, dte=17),
+                 self._row(115, .04, .3, .35, .5, dte=17)]
+        selected = SCREEN.select_sell_contract(pd.DataFrame(front+later), set())
+        self.assertTrue(selected['chain_confirmed'])
+        self.assertEqual(selected['dte'], 17)
+
